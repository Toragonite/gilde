{
  "name": "gilde-code-sidecar",
  "private": true,
  "version": "0.1.0",
  "description": "Headless lane sidecar: @toragonite/agent-mesh behind an NDJSON JSON-RPC 2.0 stdio channel",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node esbuild.mjs && node scripts/check-seam.mjs",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check:seam": "node scripts/check-seam.mjs",
    "test": "node test/stub-host.mjs && node test/mesh-methods.mjs && node test/lifecycle.mjs && node test/cco-team.mjs && node test/cco-vendor.mjs",
    "test:live": "node test/live-check.mjs"
  },
  "dependencies": {
    "@toragonite/agent-mesh": "0.1.3",
    "@toragonite/agent-mesh-claude": "0.1.3",
    "@toragonite/agent-mesh-codex": "0.1.3",
    "@toragonite/agent-mesh-cursor": "0.1.3",
    "@toragonite/agent-mesh-gemini": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
